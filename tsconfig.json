{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "allowJs": true,
    "checkJs": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "strict": true,
    "rootDir": "./modules",
    "outDir": "./modules"
  },
  "include": ["modules/**/*.js"],
  "exclude": ["node_modules"]
}
